<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vue unifiée dashboard + configuration -->
    <record id="view_copilot_dashboard" model="ir.ui.view">
        <field name="name">copilot.dashboard</field>
        <field name="model">copilot.config</field>
        <field name="arch" type="xml">
            <form string="AI Copilot Dashboard &amp; Configuration" create="false">
                <style>
                    .hover-shadow:hover {
                        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
                        transform: translateY(-3px);
                        transition: all 0.3s ease;
                    }
                    .bg-purple {
                        background-color: #6f42c1;
                    }
                    .text-purple {
                        color: #6f42c1;
                    }
                    .card {
                        transition: all 0.3s ease;
                    }
                    .progress {
                        height: 8px;
                        border-radius: 4px;
                        overflow: hidden;
                    }
                    .progress-bar {
                        transition: width 1s ease;
                    }
                    .card-header h5 {
                        margin-bottom: 0;
                    }
                </style>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <i class="fa fa-robot"/> AI Copilot Dashboard
                        </h1>
                    </div>
                    
                    <!-- Section Statistiques et Actions principales -->
                    <div class="row mt-3">
                        <!-- Colonne de gauche: Statistiques -->
                        <div class="col-md-8">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5><i class="fa fa-chart-bar"/> AI Statistics</h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="row m-0">
                                        <div class="col-md-4 p-3 border-right">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <h3 class="mb-0 text-primary"><field name="tokens_remaining"/></h3>
                                                    <p class="text-muted mb-0">Remaining Tokens</p>
                                                </div>
                                                <div class="align-self-center">
                                                    <i class="fa fa-coins fa-2x text-primary" title="Tokens"/>
                                                </div>
                                            </div>
                                            <div class="mt-2">
                                                <field name="usage_percentage" widget="progressbar" options="{'editable': false, 'max_value': 100}"/>
                                            </div>
                                            <div class="d-flex justify-content-between mt-1">
                                                <small class="text-muted"><field name="tokens_used"/> used</small>
                                                <small class="text-muted"><field name="tokens_total"/> total</small>
                                            </div>
                                        </div>
                                        
                                        <div class="col-md-4 p-3 border-right">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <h3 class="mb-0 text-success"><field name="selected_model"/></h3>
                                                    <p class="text-muted mb-0">AI Model</p>
                                                </div>
                                                <div class="align-self-center">
                                                    <i class="fa fa-brain fa-2x text-success" title="AI Model"/>
                                                </div>
                                            </div>
                                            <div class="text-center mt-2">
                                                <button name="get_available_models" string="Change Model" type="object" class="btn btn-sm btn-outline-success" icon="fa-exchange"/>
                                            </div>
                                        </div>
                                        
                                        <div class="col-md-4 p-3">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <h3 class="mb-0 text-info"><field name="status"/></h3>
                                                    <p class="text-muted mb-0">Status</p>
                                                </div>
                                                <div class="align-self-center">
                                                    <i class="fa fa-heartbeat fa-2x text-info" title="Status"/>
                                                </div>
                                            </div>
                                            <div class="text-center mt-2">
                                                <small class="text-muted">Last sync: <field name="last_sync"/></small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Colonne de droite: Actions principales -->
                        <div class="col-md-4">
                            <div class="card h-100">
                                <div class="card-header bg-success text-white">
                                    <h5><i class="fa fa-bolt"/> Quick Actions</h5>
                                </div>
                                <div class="card-body d-flex flex-column justify-content-center">
                                    <button name="sync_quota" string="Sync Tokens" type="object" class="btn btn-primary btn-lg mb-2"  >
                                        <i class="fa fa-refresh mr-2"/>Sync Tokens
                                    </button>
                                    <button name="open_buy_credits" string="Buy Tokens" type="object" class="btn btn-success btn-lg mb-2"  >
                                        <i class="fa fa-credit-card mr-2"/>Buy Tokens
                                    </button>
                                    <button name="open_copilot_store" string="Discover Modules" type="object" class="btn btn-info btn-lg"  >
                                        <i class="fa fa-puzzle-piece mr-2"/>Discover Modules
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Section Configuration -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header bg-info text-white">
                                    <h5><i class="fa fa-cog"/> Configuration</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="user_token" class="font-weight-bold">
                                                    <i class="fa fa-key"/> API Token
                                                </label>
                                                <div class="input-group">
                                                    <field name="user_token" widget="char" 
                                                           placeholder="Enter your AI client token" 
                                                           class="form-control" required="1" 
                                                           readonly="0" password="True" force_save="1"/>
                                                    <div class="input-group-append">
                                                        <button name="test_connection" string="Test" 
                                                                type="object" class="btn btn-outline-primary"/>
                                                    </div>
                                                </div>
                                                <small class="text-muted">Your personal access key to AI services</small>
                                            </div>
                                            <div class="form-group">
                                                <label for="api_endpoint" class="font-weight-bold">
                                                    <i class="fa fa-link"/> API Endpoint
                                                </label>
                                                <field name="api_endpoint" class="form-control" placeholder="https://api.example.com/v1"/>
                                                <small class="text-muted">API server address for AI services</small>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="selected_model" class="font-weight-bold">
                                                    <i class="fa fa-brain"/> AI Model
                                                </label>
                                                <field name="selected_model" class="form-control"/>
                                                <small class="text-muted">AI model used for generating responses</small>
                                            </div>
                                            <!-- Language selection temporairement désactivé -->
                                            <div class="form-group">
                                                <div class="font-weight-bold mb-2">
                                                    <i class="fa fa-language"/> Language
                                                </div>
                                                <div class="alert alert-info">
                                                    <small>Language selection will be available after database update</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Available Modules -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header bg-purple text-white">
                                    <h5><i class="fa fa-puzzle-piece"/> Available Modules</h5>
                                </div>
                                <div class="card-body">
                                    <!-- Installed modules section -->
                                    <div class="mb-4">
                                        <h6 class="text-primary mb-3"><i class="fa fa-check-circle"/> Installed Modules</h6>
                                        <field name="installed_modules_html" widget="html" nolabel="1"/>
                                    </div>
                                    
                                    <!-- Available modules section -->
                                    <div class="mb-4">
                                        <h6 class="text-primary mb-3"><i class="fa fa-puzzle-piece"/> Available Modules</h6>
                                        <div class="row">
                                            <div class="col-md-6 col-lg-3 mb-3">
                                                <div class="card h-100 border-primary hover-shadow">
                                                    <div class="card-body text-center">
                                                        <img src="/copilot_core/static/description/copilot_crm.jpg" class="img-fluid mb-2" style="max-height: 80px; border-radius: 5px;" title="CRM"/>
                                                        <h6 class="card-title">🎯 Copilot CRM</h6>
                                                        <p class="card-text small">AI Sales Assistant</p>
                                                        <ul class="list-unstyled small text-left">
                                                            <li><i class="fa fa-check text-success"></i> Intelligent prospect analysis</li>
                                                            <li><i class="fa fa-check text-success"></i> AI conversion scoring</li>
                                                            <li><i class="fa fa-check text-success"></i> AI quote generation</li>
                                                        </ul>
                                                        <span class="badge badge-success">399€</span>
                                                    </div>
                                                    <div class="card-footer bg-transparent border-0 text-center">
                                                        <a href="https://www.copilot4odoo.com/shop/copilot-crm-15" target="_blank" class="btn btn-sm btn-outline-primary">Learn More</a>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="col-md-6 col-lg-3 mb-3">
                                                <div class="card h-100 border-primary hover-shadow">
                                                    <div class="card-body text-center">
                                                        <img src="/copilot_core/static/description/copilot_hr.jpg" class="img-fluid mb-2" style="max-height: 80px; border-radius: 5px;" title="HR"/>
                                                        <h6 class="card-title">👥 Copilot HR</h6>
                                                        <p class="card-text small">AI Human Resources Assistant</p>
                                                        <ul class="list-unstyled small text-left">
                                                            <li><i class="fa fa-check text-success"></i> Automatic employee profiles</li>
                                                            <li><i class="fa fa-check text-success"></i> Turnover risk prediction</li>
                                                            <li><i class="fa fa-check text-success"></i> Talent detection</li>
                                                        </ul>
                                                        <span class="badge badge-success">399€</span>
                                                    </div>
                                                    <div class="card-footer bg-transparent border-0 text-center">
                                                        <a href="https://www.copilot4odoo.com/shop/copilot-hr-18" target="_blank" class="btn btn-sm btn-outline-primary">Learn More</a>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="col-md-6 col-lg-3 mb-3">
                                                <div class="card h-100 border-primary hover-shadow">
                                                    <div class="card-body text-center">
                                                        <img src="/copilot_core/static/description/copilot_stock.jpg" class="img-fluid mb-2" style="max-height: 80px; border-radius: 5px;" title="Inventory"/>
                                                        <h6 class="card-title">📦 Copilot Inventory</h6>
                                                        <p class="card-text small">AI Inventory Assistant</p>
                                                        <ul class="list-unstyled small text-left">
                                                            <li><i class="fa fa-check text-success"></i> Stock-out predictions</li>
                                                            <li><i class="fa fa-check text-success"></i> Inventory optimization</li>
                                                            <li><i class="fa fa-check text-success"></i> Demand trend analysis</li>
                                                        </ul>
                                                        <span class="badge badge-success">399€</span>
                                                    </div>
                                                    <div class="card-footer bg-transparent border-0 text-center">
                                                        <a href="https://www.copilot4odoo.com/shop/copilot-inventory" target="_blank" class="btn btn-sm btn-outline-primary">Learn More</a>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="col-md-6 col-lg-3 mb-3">
                                                <div class="card h-100 border-primary hover-shadow">
                                                    <div class="card-body text-center">
                                                        <img src="/copilot_core/static/description/copilot_compta.jpg" class="img-fluid mb-2" style="max-height: 80px; border-radius: 5px;" title="Accounting"/>
                                                        <h6 class="card-title">💰 Copilot Accounting</h6>
                                                        <p class="card-text small">AI Accounting Assistant</p>
                                                        <ul class="list-unstyled small text-left">
                                                            <li><i class="fa fa-check text-success"></i> Anomaly detection</li>
                                                            <li><i class="fa fa-check text-success"></i> Financial predictions</li>
                                                            <li><i class="fa fa-check text-success"></i> Automated reconciliation</li>
                                                        </ul>
                                                        <span class="badge badge-success">399€</span>
                                                    </div>
                                                    <div class="card-footer bg-transparent border-0 text-center">
                                                        <a href="https://www.copilot4odoo.com/shop/copilot-accounting" target="_blank" class="btn btn-sm btn-outline-primary">Learn More</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Statistiques d'usage détaillées -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5><i class="fa fa-chart-line"/> Statistiques d'Usage IA</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <div class="progress mb-3" style="height: 25px;">
                                                <div class="progress-bar bg-success" role="progressbar" 
                                                     style="width: 75%" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">
                                                    <strong><field name="tokens_used"/> / <field name="tokens_total"/> tokens utilisés (<field name="usage_percentage" widget="float" digits="[16,1]"/>%)</strong>
                                                </div>
                                            </div>
                                            <div class="row text-center">
                                                <div class="col-md-4">
                                                    <div class="border-right">
                                                        <h4 class="text-success"><field name="tokens_remaining"/></h4>
                                                        <small class="text-muted">Tokens Restants</small>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="border-right">
                                                        <h4 class="text-primary"><field name="tokens_used"/></h4>
                                                        <small class="text-muted">Tokens Utilisés</small>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <h4 class="text-info"><field name="tokens_total"/></h4>
                                                    <small class="text-muted">Quota Total</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="text-center">
                                                <h6><i class="fa fa-calendar"/> Dernière Synchronisation</h6>
                                                <p class="text-muted"><field name="last_sync"/></p>
                                                <small class="text-info"><i class="fa fa-info-circle"/> Utilisez l'onglet Configuration pour synchroniser</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Historique d'usage récent -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5><i class="fa fa-history"/> Activité IA Récente</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6><i class="fa fa-brain"/> Modèle IA Actuel</h6>
                                            <div class="alert alert-info">
                                                <strong><field name="selected_model"/></strong>
                                                <br/><small>Modèle sélectionné pour les requêtes IA</small>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <h6><i class="fa fa-server"/> Statut du Service</h6>
                                            <div class="alert alert-success" invisible="status != 'active'">
                                                <i class="fa fa-check-circle"/> <strong>Service Actif</strong>
                                                <br/><small>Toutes les fonctionnalités IA sont opérationnelles</small>
                                            </div>
                                            <div class="alert alert-warning" invisible="status != 'quota_exceeded'">
                                                <i class="fa fa-exclamation-triangle"/> <strong>Quota Dépassé</strong>
                                                <br/><small>Rechargez vos crédits pour continuer</small>
                                            </div>
                                            <div class="alert alert-danger" invisible="status in ['active', 'quota_exceeded']">
                                                <i class="fa fa-times-circle"/> <strong>Service Indisponible</strong>
                                                <br/><small>Vérifiez votre configuration</small>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <h6><i class="fa fa-info-circle"/> Informations Système</h6>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-borderless">
                                                    <tr>
                                                        <td><strong>Version Copilot Core:</strong></td>
                                                        <td><span class="badge badge-primary">18.0.1.1.0</span></td>
                                                        <td><strong>Endpoint API:</strong></td>
                                                        <td><field name="api_endpoint"/></td>
                                                    </tr>
                                                    <tr>
                                                        <td><strong>Installed Modules:</strong></td>
                                                        <td colspan="3">
                                                            <field name="installed_modules_html" widget="html" nolabel="1"/>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Action serveur pour le dashboard -->
    <record id="action_copilot_dashboard_server" model="ir.actions.server">
        <field name="name">Dashboard Copilot IA</field>
        <field name="model_id" ref="model_copilot_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>
    
    <!-- Action fenêtre pour le dashboard (remplace l'ancienne) -->
    <record id="action_copilot_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard Copilot IA</field>
        <field name="res_model">copilot.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_copilot_dashboard"/>
        <field name="target">current</field>
        <field name="context">{'form_view_initial_mode': 'readonly'}</field>
    </record>

</odoo>
